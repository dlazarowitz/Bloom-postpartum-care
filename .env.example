# Bloom Postpartum Care App - Environment Variables

# Anthropic API Key (used by the backend server ONLY - never expose in mobile app)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Backend server URL (the mobile app connects to this)
API_BASE_URL=http://localhost:3001

# Grocery API integrations (optional - for future production use)
# These would be replaced with actual retailer API keys
KROGER_API_KEY=your-kroger-api-key
INSTACART_API_KEY=your-instacart-api-key
